node_modules/
dist/
.claude/worktrees/
.DS_Store
*.log
dist-headless/
.freesound-tokens.json

# Tauri desktop shell (D1) — Rust build artifacts, never committed. (Cargo.lock IS committed,
# per Rust convention for applications — reproducible builds.)
target/

# beatlab is cloned as a scratch checkout outside the repo for desktop dev/testing — if anyone
# ever clones it *inside* the worktree by mistake, don't let it land in git history.
/beatlab/

# Reference material for research (e.g. Ableton's own manual) — large binaries, never committed.
/prior_art/

# Owner-side Python venv for the ML sidecars (python/README.md) — machine-local, never committed.
python/.venv
# Dedicated venv for the roughness sidecar (MoSQITo can conflict with the shared venv's pins).
# No trailing slash so a symlink-to-venv (used when developing in a git worktree) is ignored too.
python/venv-roughness

# CLI render outputs inside example projects — regenerable from the .beat + media.
examples/*/render-*.wav
examples/media/*.sf2

# Per-render feature-vector cache (src/taste/features.ts). Unlike the embedding/aesthetics
# sidecars next to it, this one is pure deterministic DSP — recomputable in milliseconds from the
# wav alone — so it is a speed cache, not a record. It is invalidated by FEATURE_SET_VERSION.
*.features.json
